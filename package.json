{
  "name": "wftdm-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WFRC TDM Calibration Dashboard — data/state layer scaffold",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/postinstall.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "pretest:integration": "uv run python tests/fixtures/generate.py",
    "test:integration": "playwright test",
    "dev:fixtures": "node scripts/copy-fixtures.js"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "apache-arrow": "^18.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "coi-serviceworker": "^0.1.7",
    "dompurify": "^3.4.14",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.11",
    "plotly.js-dist-min": "^2.35.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
