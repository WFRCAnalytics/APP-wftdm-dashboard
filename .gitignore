test-results/
blob-report/
# 030-sidebar-navigation — cross-worker mutual-exclusion lock file used by
# tests/integration/_sharedFixtureLock.ts (sidebarNav.spec.ts,
# fullPagePanel.spec.ts, demoContentAllPanels.spec.ts,
# dashboardShell.spec.ts's own tab-count test). Created/removed for the
# duration of one Playwright run; never meant to be committed.
.tmp-shared-fixture-index.lock

# ── Fixture copies into public/ ───────────────────────────────────────────────
# Made by tests/global-setup.js (removed by tests/global-teardown.js after a
# Playwright run) and by scripts/copy-fixtures.js (npm run dev:fixtures, for a
# manual `npm run dev` check) — never meant to land in the production public/
# tree. *.parquet is already covered by the blanket rule below, but the
# manifest.yaml/index.json/dashboard-*.yaml files copied alongside them
# weren't, so a stray `git add -A` could otherwise commit them.
/public/observed/
/public/scenarios/
/public/dashboard-config/

# ── Vite build output ─────────────────────────────────────────────────────────
# dist/ is the Vite JS build — NOT committed to main branch
# Deployed to gh-pages branch via GitHub Actions
# Embedded in Python package via `make build` but excluded here
dist/

# ── Embedded static files ─────────────────────────────────────────────────────
# Generated by `make build` — copies dist/ into the Python package
# Never commit; always re-generatable
python/wftdm_dashboard/static/

# ── DuckDB ───────────────────────────────────────────────────────────────────
*.duckdb
*.duckdb.wal
*.db
*.db.wal

# ── Data files — never commit model output ────────────────────────────────────
*.parquet
*.geoparquet
*.omx
*.h5
*.hdf5
*.csv.gz

# 026-activitysim-demo-content: public/demo-scenarios/ is this project's
# first REAL, permanent, git-tracked scenario content (see CLAUDE.md item
# 15) — unlike every other Parquet on disk, its .parquet files are the
# actual deliverable, not ephemeral fixture/model-run output, and must be
# committed. Scoped negation, this one content root only — public/scenarios/
# and public/geometry/ (fixture-copy destinations, see the "Fixture copies
# into public/" block above) correctly keep the blanket rule.
!/public/demo-scenarios/**/*.parquet

# 031-all-panel-demo-content: same reasoning, for the new real, permanent,
# git-tracked TAZ 1-25 boundary geometry (public/demo-geometry/) — real
# MTC-sourced geometry, not ephemeral fixture/model-run output. public/
# geometry/ (fixture-copy destination) correctly keeps the blanket rule.
!/public/demo-geometry/**/*.geoparquet

# ── Dashboard YAML configs ────────────────────────────────────────────────────
# .wfrc/ configs live in the model repo alongside scenario output, not here
.wfrc/

