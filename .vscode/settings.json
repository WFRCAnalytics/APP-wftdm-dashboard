{
  // ── Python ─────────────────────────────────────────────────────────────────
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

  // ── Ruff (linter + formatter) ───────────────────────────────────────────────
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  // ── JavaScript ─────────────────────────────────────────────────────────────
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // ── YAML ───────────────────────────────────────────────────────────────────
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "yaml.schemas": {
    // Associate dashboard YAML files with our grammar schema (future)
    "./project-docs/GRAMMAR.md": [
      ".wfrc/dashboard-*.yaml",
      ".wfrc/summarize.yaml",
      ".wfrc/manifest.yaml"
    ]
  },

  // ── TOML ───────────────────────────────────────────────────────────────────
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },

  // ── Editor ─────────────────────────────────────────────────────────────────
  "editor.rulers": [100],           // matches ruff line-length
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",               // LF line endings (matches ruff line-ending = auto)

  // ── File associations ──────────────────────────────────────────────────────
  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml"
  },

  // ── Exclude from explorer ──────────────────────────────────────────────────
  "files.exclude": {
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.vscode": false            // keep .vscode visible so team can edit settings
  },

  // ── Search exclusions ──────────────────────────────────────────────────────
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.venv": true,
    "**/uv.lock": true,
    "python/wftdm_dashboard/static": true
  }
}
